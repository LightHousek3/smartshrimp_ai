# ============================================
# SmartShrimp RAG Service - Environment
# ============================================

# App
APP_ENV=development
APP_VERSION=1.0.0

# Internal API Key (smartshrimp_be)
INTERNAL_API_KEY=

# Browser CORS policy (list values use JSON arrays).
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["POST","GET"]
CORS_ALLOW_HEADERS=["*"]

# Google Gemini
GEMINI_INGESTION_API_KEY=
GEMINI_QUERY_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=["gemini-3.1-flash-lite"]
INGESTION_EMBED_TIMEOUT_SECONDS=20

# PostgreSQL + pgvector (smartshrimp_be)
DATABASE_URL=

# Connection limits per RAG worker.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=3

# RAG Settings
SIMILARITY_THRESHOLD=0.5
TOP_K_DEFAULT=3
CHUNK_OVERLAP=150
SEMANTIC_BREAKPOINT_PERCENTILE=90
MIN_CHUNK_SIZE=350
MAX_CHUNK_SIZE=1200

# LLM Token Budget
MAX_CONTEXT_TOKENS=1048576
MAX_OUTPUT_TOKENS=2048

# Logging
LOG_LEVEL=DEBUG
